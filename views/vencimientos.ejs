<%- include('partials/header', { title: 'Vencimientos' }) %>

<%
function diasRestantes(fecha) {
  const hoy = new Date();
  const hoyUTC = Date.UTC(hoy.getFullYear(), hoy.getMonth(), hoy.getDate());
  const f = new Date(fecha);
  const fUTC = Date.UTC(f.getUTCFullYear(), f.getUTCMonth(), f.getUTCDate());
  return Math.round((fUTC - hoyUTC) / 86400000);
}

function estaAlDia(v) {
  if (v.pagado) return true;
  return diasRestantes(v.proximoVencimiento) > 15;
}

function claseFila(v) {
  if (estaAlDia(v)) return 'venc-pagado';
  const dias = diasRestantes(v.proximoVencimiento);
  return dias <= 5 ? 'venc-urgente' : 'venc-atencion';
}

function formatoFecha(fecha) {
  if (!fecha) return '-';
  return new Date(fecha).toLocaleDateString('es-AR', { timeZone: 'UTC' });
}

function fechaInput(fecha) {
  if (!fecha) return '';
  return new Date(fecha).toISOString().slice(0, 10);
}
%>

<div class="container-fluid">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
      <h3 class="mb-0">Vencimientos</h3>
      <small class="text-muted">Pagos y vencimientos por empresa/servicio</small>
    </div>

    <button class="btn btn-primary" id="btnNuevoVencimiento" type="button">
      <i class="fa-solid fa-plus me-1"></i> Agregar
    </button>
  </div>

  <div class="d-flex flex-wrap gap-3 mb-3 small">
    <span><span class="badge venc-pagado border">&nbsp;&nbsp;</span> Al día (pagado o faltan más de 15 días)</span>
    <span><span class="badge venc-atencion border">&nbsp;&nbsp;</span> 15 días o menos</span>
    <span><span class="badge venc-urgente border">&nbsp;&nbsp;</span> 5 días o menos / vencido</span>
  </div>

  <div class="row g-2 align-items-end mb-3">
    <div class="col-md-6 col-lg-4">
      <label class="form-label" for="buscarVencimiento">Buscar</label>
      <input id="buscarVencimiento" class="form-control" type="search" placeholder="Empresa o descripción">
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle" id="tablaVencimientos">
      <thead class="table-dark">
        <tr>
          <th>Empresa</th>
          <th>Descripción</th>
          <th>Último vencimiento</th>
          <th>Próximo vencimiento</th>
          <th>Pago</th>
          <th class="text-end">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if (!vencimientos.length) { %>
          <tr data-empty-row>
            <td colspan="6" class="text-center text-muted py-4">No hay vencimientos registrados</td>
          </tr>
        <% } %>

        <% vencimientos.forEach(v => { %>
          <tr
            class="<%= claseFila(v) %>"
            data-id="<%= v._id %>"
            data-empresa="<%= v.empresa %>"
            data-descripcion="<%= v.descripcion %>"
            data-ultimo="<%= fechaInput(v.ultimoVencimiento) %>"
            data-proximo="<%= fechaInput(v.proximoVencimiento) %>"
            data-pagado="<%= v.pagado %>"
            data-historial='<%- JSON.stringify(v.historialPagos || []).replace(/</g, "\\u003c") %>'>
            <td><%= v.empresa %></td>
            <td><%= v.descripcion %></td>
            <td><%= formatoFecha(v.ultimoVencimiento) %></td>
            <td><%= formatoFecha(v.proximoVencimiento) %></td>
            <td><%= estaAlDia(v) ? 'Sí' : 'No' %></td>
            <td class="text-end">
              <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-success" type="button" data-pagar="<%= v._id %>" title="Registrar pago">
                  <i class="fa-solid fa-money-bill-wave"></i>
                </button>
                <button class="btn btn-outline-secondary" type="button" data-historial="<%= v._id %>" title="Historial de pagos">
                  <i class="fa-solid fa-clock-rotate-left"></i>
                </button>
                <button class="btn btn-outline-primary" type="button" data-editar="<%= v._id %>" title="Modificar">
                  <i class="fa-solid fa-pen-to-square"></i>
                </button>
                <button class="btn btn-outline-danger" type="button" data-eliminar="<%= v._id %>" title="Eliminar">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Modal: Agregar/Editar -->
<div class="modal fade" id="modalVencimiento" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" id="formVencimiento">
      <div class="modal-header">
        <h5 class="modal-title" id="modalVencimientoTitulo">Agregar vencimiento</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <input type="hidden" id="vencimientoId">

        <div class="mb-3">
          <label class="form-label" for="empresaVencimiento">Nombre de la empresa</label>
          <input class="form-control" id="empresaVencimiento" name="empresa" required>
        </div>

        <div class="mb-3">
          <label class="form-label" for="descripcionVencimiento">Descripción</label>
          <input class="form-control" id="descripcionVencimiento" name="descripcion">
        </div>

        <div class="mb-3" id="grupoUltimoVencimiento">
          <label class="form-label" for="ultimoVencimientoInput">Último vencimiento</label>
          <input type="date" class="form-control" id="ultimoVencimientoInput" name="ultimoVencimiento">
        </div>

        <div class="mb-3">
          <label class="form-label" for="proximoVencimientoInput">Próximo vencimiento</label>
          <input type="date" class="form-control" id="proximoVencimientoInput" name="proximoVencimiento" required>
        </div>

        <div class="form-check form-switch mb-0">
          <input class="form-check-input" type="checkbox" id="pagadoVencimiento" name="pagado">
          <label class="form-check-label" for="pagadoVencimiento">Pagado</label>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Registrar pago -->
<div class="modal fade" id="modalPagarVencimiento" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" id="formPagarVencimiento">
      <div class="modal-header">
        <h5 class="modal-title">Registrar pago</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <input type="hidden" id="pagarVencimientoId">
        <p class="mb-3">Vencimiento actual: <strong id="pagarVencimientoFechaActual"></strong></p>

        <div class="mb-0">
          <label class="form-label" for="proximoVencimientoPago">¿Se repite? Ingresá el próximo vencimiento (opcional)</label>
          <input type="date" class="form-control" id="proximoVencimientoPago" name="proximoVencimiento">
          <div class="form-text">Si lo dejás vacío, el vencimiento queda marcado como pagado sin generar uno nuevo.</div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-success">Confirmar pago</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Historial de pagos -->
<div class="modal fade" id="modalHistorialVencimiento" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Historial de pagos - <span id="historialEmpresaNombre"></span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <ul class="list-group" id="listaHistorialPagos"></ul>
      </div>
    </div>
  </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
  <div id="toastVencimientos" class="toast text-bg-success border-0">
    <div class="d-flex">
      <div class="toast-body" id="toastVencimientosMsg"></div>
      <button class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
</div>

<script src="/resources/js/vencimientos.js" defer></script>

<%- include('partials/footer') %>
