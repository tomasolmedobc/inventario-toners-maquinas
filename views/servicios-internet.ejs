<%- include('partials/header', { title: 'Servicios de Internet' }) %>

<div class="container-fluid">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
      <h3 class="mb-0">Servicios de Internet por Área</h3>
      <small class="text-muted">Proveedor, dirección y contacto de cada área</small>
    </div>

    <button class="btn btn-primary" id="btnNuevoServicioInternet" type="button">
      <i class="fa-solid fa-plus me-1"></i> Agregar
    </button>
  </div>

  <div class="row g-2 align-items-end mb-3">
    <div class="col-md-6 col-lg-4">
      <label class="form-label" for="buscarServicioInternet">Buscar</label>
      <input id="buscarServicioInternet" class="form-control" type="search" placeholder="Proveedor, área, dirección, teléfono o persona a cargo">
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle" id="tablaServiciosInternet">
      <thead class="table-dark">
        <tr>
          <th>Proveedor</th>
          <th>Área</th>
          <th>Dirección</th>
          <th>Teléfono</th>
          <th>Persona a Cargo</th>
          <th class="text-end">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if (!servicios.length) { %>
          <tr data-empty-row>
            <td colspan="6" class="text-center text-muted py-4">No hay servicios de internet registrados</td>
          </tr>
        <% } %>

        <% servicios.forEach(s => { %>
          <tr
            data-id="<%= s._id %>"
            data-proveedor="<%= s.proveedor %>"
            data-area-id="<%= s.area?._id || '' %>"
            data-area-nombre="<%= s.area?.nombre || '' %>"
            data-direccion="<%= s.direccion %>"
            data-telefono="<%= s.telefono %>"
            data-persona="<%= s.personaCargo %>">
            <td><%= s.proveedor %></td>
            <td><%= s.area?.nombre || 'Sin área' %></td>
            <td><%= s.direccion %></td>
            <td><%= s.telefono %></td>
            <td><%= s.personaCargo %></td>
            <td class="text-end">
              <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-primary" type="button" data-editar="<%= s._id %>" title="Modificar">
                  <i class="fa-solid fa-pen-to-square"></i>
                </button>
                <button class="btn btn-outline-danger" type="button" data-eliminar="<%= s._id %>" title="Eliminar">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="modal fade" id="modalServicioInternet" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" id="formServicioInternet">
      <div class="modal-header">
        <h5 class="modal-title" id="modalServicioInternetTitulo">Agregar servicio de internet</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <input type="hidden" id="servicioInternetId">

        <div class="mb-3">
          <label class="form-label" for="proveedorServicioInternet">Nombre proveedor</label>
          <input class="form-control" id="proveedorServicioInternet" name="proveedor" required>
        </div>

        <div class="mb-3">
          <label class="form-label" for="areaServicioInternet">Área</label>
          <select class="form-select" id="areaServicioInternet" name="area" required>
            <option value="">Seleccionar área</option>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label" for="direccionServicioInternet">Dirección</label>
          <input class="form-control" id="direccionServicioInternet" name="direccion" required>
        </div>

        <div class="mb-3">
          <label class="form-label" for="telefonoServicioInternet">Teléfono</label>
          <input class="form-control" id="telefonoServicioInternet" name="telefono" required>
        </div>

        <div class="mb-0">
          <label class="form-label" for="personaCargoServicioInternet">Persona a Cargo</label>
          <input class="form-control" id="personaCargoServicioInternet" name="personaCargo" required>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar</button>
      </div>
    </form>
  </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
  <div id="toastServiciosInternet" class="toast text-bg-success border-0">
    <div class="d-flex">
      <div class="toast-body" id="toastServiciosInternetMsg"></div>
      <button class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
</div>

<script src="/resources/js/serviciosInternet.js" defer></script>

<%- include('partials/footer') %>
